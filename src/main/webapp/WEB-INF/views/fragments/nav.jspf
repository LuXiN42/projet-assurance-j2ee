<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ici" value="${requestScope['jakarta.servlet.forward.request_uri']}"/>
<c:set var="moi" value="${sessionScope.utilisateur}"/>
<nav class="nav ${navSombre ? 'sombre' : ''}">
    <a class="marque" href="${ctx}/">
        <span class="logo"><span class="b">B</span><span class="c">care</span></span>
        <span class="mot">B<span class="apos">'</span><span class="care">Care</span></span>
    </a>

    <ul class="liens">
        <c:choose>
            <c:when test="${moi.role == 'CLIENT'}">
                <li><a href="${ctx}/client/accueil" class="${fn:endsWith(ici, '/client/accueil') ? 'actif' : ''}">Accueil</a></li>
                <li><a href="${ctx}/client/contrats" class="${fn:contains(ici, '/client/contrat') ? 'actif' : ''}">Mes contrats</a></li>
                <li><a href="${ctx}/client/sinistres" class="${fn:contains(ici, '/client/sinistres') ? 'actif' : ''}">Mes sinistres</a></li>
                <li><a href="${ctx}/client/paiements" class="${fn:contains(ici, '/client/paiements') ? 'actif' : ''}">Mes paiements</a></li>
                <li><a href="${ctx}/client/assistant" class="${fn:contains(ici, '/client/assistant') ? 'actif' : ''}">Bibi</a></li>
            </c:when>
            <c:when test="${moi.role == 'AGENT'}">
                <li><a href="${ctx}/agent/accueil" class="${fn:endsWith(ici, '/agent/accueil') ? 'actif' : ''}">Accueil</a></li>
                <li><a href="${ctx}/agent/clients" class="${fn:contains(ici, '/agent/clients') ? 'actif' : ''}">Clients</a></li>
                <li><a href="${ctx}/agent/contrats" class="${fn:contains(ici, '/agent/contrats') ? 'actif' : ''}">Contrats</a></li>
                <li><a href="${ctx}/agent/sinistres" class="${fn:contains(ici, '/agent/sinistres') || fn:contains(ici, 'traiter') ? 'actif' : ''}">Sinistres</a></li>
                <li><a href="${ctx}/agent/garanties" class="${fn:contains(ici, '/agent/garanties') ? 'actif' : ''}">Garanties</a></li>
                <li><a href="${ctx}/agent/paiements" class="${fn:contains(ici, '/agent/paiements') ? 'actif' : ''}">Paiements</a></li>
                <li><a href="${ctx}/agent/statistiques" class="${fn:contains(ici, '/agent/statistiques') ? 'actif' : ''}">Statistiques</a></li>
            </c:when>
            <c:when test="${moi.role == 'ADMIN'}">
                <li><a href="${ctx}/admin/accueil" class="${fn:endsWith(ici, '/admin/accueil') ? 'actif' : ''}">Accueil</a></li>
                <li><a href="${ctx}/admin/utilisateurs" class="${fn:contains(ici, '/admin/utilisateurs') ? 'actif' : ''}">Utilisateurs</a></li>
                <li><a href="${ctx}/admin/types" class="${fn:contains(ici, '/admin/types') ? 'actif' : ''}">Types d'assurance</a></li>
                <li><a href="${ctx}/agent/contrats" class="${fn:contains(ici, '/agent/contrats') ? 'actif' : ''}">Contrats</a></li>
                <li><a href="${ctx}/agent/sinistres" class="${fn:contains(ici, '/agent/sinistres') ? 'actif' : ''}">Sinistres</a></li>
                <li><a href="${ctx}/admin/statistiques" class="${fn:contains(ici, '/admin/statistiques') ? 'actif' : ''}">Statistiques</a></li>
            </c:when>
            <c:otherwise>
                <li><a href="${ctx}/#offres">Nos assurances</a></li>
                <li><a href="${ctx}/#etapes">Comment ça marche</a></li>
                <li><a href="${ctx}/#assistant">Bibi</a></li>
            </c:otherwise>
        </c:choose>
    </ul>

    <div class="droite">
        <c:choose>
            <c:when test="${not empty moi}">
                <a class="moi ${fn:endsWith(ici, '/profil') ? 'actif' : ''}" href="${ctx}/profil" title="Mon profil">
                    <span class="initiale"><c:out value="${fn:toUpperCase(fn:substring(moi.prenom, 0, 1))}"/></span>
                    <c:out value="${moi.prenom}"/>
                </a>
                <button type="button" class="deco" data-modale="modale-deco" title="Déconnexion">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v9"/><path d="M6.4 6.4a8 8 0 1 0 11.2 0"/></svg>
                    <span>Déconnexion</span>
                </button>
            </c:when>
            <c:otherwise>
                <a class="btn btn-leger" href="${ctx}/login">Se connecter</a>
                <a class="btn" href="${ctx}/inscription">Créer un compte</a>
            </c:otherwise>
        </c:choose>
    </div>
</nav>

<c:if test="${not empty moi}">
    <div class="modale" id="modale-deco" hidden>
        <div class="modale-fond" data-fermer></div>
        <div class="modale-boite">
            <span class="ico-rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v9"/><path d="M6.4 6.4a8 8 0 1 0 11.2 0"/></svg></span>
            <h3>Se déconnecter ?</h3>
            <p>Vous devrez vous reconnecter pour revenir sur votre espace.</p>
            <div class="modale-actions">
                <button type="button" class="btn-leger" data-fermer>Annuler</button>
                <a class="btn btn-rouge" href="${ctx}/logout">Me déconnecter</a>
            </div>
        </div>
    </div>
</c:if>
