<%@ page pageEncoding="UTF-8" %>
<div class="bibi ${bibiClasse}" data-url="${ctx}/client/assistant">
    <button type="button" class="bibi-bulle" data-bibi="ouvrir">
        <span class="bibi-avatar">B</span>Bibi
    </button>

    <section class="bibi-fenetre">
        <header class="bibi-tete">
            <span class="bibi-avatar">B</span>
            <div class="titre"><b>Bibi</b><small>Assistant B'Care · en ligne</small></div>
            <button type="button" data-bibi="effacer" title="Nouvelle conversation">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            </button>
            <button type="button" data-bibi="reduire" title="Réduire">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
        </header>

        <div class="bibi-messages"></div>

        <div class="bibi-suggestions">
            <button type="button">Quels sont mes contrats ?</button>
            <button type="button">Suis-je couvert contre le vol ?</button>
            <button type="button">Comment déclarer un sinistre ?</button>
            <button type="button">Où en est mon dernier sinistre ?</button>
        </div>

        <form class="bibi-saisie">
            <input name="question" maxlength="500" placeholder="Écrivez à Bibi…" autocomplete="off" required>
            <button type="submit" title="Envoyer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </button>
        </form>
    </section>
</div>
