<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
  "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <property name="hibernate.connection.url"><![CDATA[jdbc:mysql://localhost:3306/assurance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC]]></property>
    <property name="hibernate.connection.username">assurance</property>
    <property name="hibernate.connection.password">Assurance2026!</property>
    <property name="hibernate.show_sql">true</property>
    <property name="hibernate.format_sql">true</property>
    <property name="hibernate.hbm2ddl.auto">update</property>

    <mapping class="com.assurance.model.Utilisateur"/>
    <mapping class="com.assurance.model.TypeAssurance"/>
    <mapping class="com.assurance.model.Garantie"/>
    <mapping class="com.assurance.model.Contrat"/>
    <mapping class="com.assurance.model.Sinistre"/>
    <mapping class="com.assurance.model.PieceJustificative"/>
    <mapping class="com.assurance.model.Paiement"/>
    <mapping class="com.assurance.model.Commentaire"/>
  </session-factory>
</hibernate-configuration>